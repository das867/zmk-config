#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB       |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | ESC/LSFT   |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | LCTRL      |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | RCTRL|
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp GRAVE   	   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &mt LSHIFT ESC  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LCTRL 	   &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RCTRL
                  	&kp LGUI &mo 1 &kp RET     &kp SPACE &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | LEFT|RIGHT| UP  | [   |   | ]   | DWN |  UP | RGT |     |      |
// | BGNXT| BT2 | BT3 |     | DOWN| {   |   | }   |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB      &kp N1       &kp N2       &kp N3        &kp N4          &kp N5          &kp N6          &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR   &bt BT_SEL 0 &kp LEFT     &kp RIGHT     &kp UP          &kp LBKT        &kp RBKT        &kp DOWN &kp UP &kp RIGHT &trans &trans
   &bt BT_NXT   &bt BT_SEL 1 &bt BT_SEL 2 &trans        &kp DOWN        &kp LBRC        &kp RBRC        &trans   &trans &trans    &trans &trans
                                        &kp LGUI        &trans          &kp RET         &kp SPACE       &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     | HOME|PAGE UP|  _  |   |  =  |  PG_UP  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     | END |PAGE DN|  -  |   |  +  |  PG_DN  |  {  |  }  | "|" |  ~   |
//                    | GUI |       | SPC |   | ENT |         | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR  &kp PRCNT      &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &kp HOME &kp PG_UP &kp UNDER      &kp EQUAL &kp HOME  &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &kp END  &kp PG_DN &kp MINUS      &kp PLUS  &kp END   &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans    &kp SPACE      &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
